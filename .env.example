# ---------------------------------------------------------------------------
# DilRaaj Gym & Fitness Centre — environment template
# Copy to .env and fill in. The app runs with every Supabase value empty.
# ---------------------------------------------------------------------------

# Demo content store (PostgreSQL via Drizzle). Required for editable CMS content.
DATABASE_URL=postgresql://neondb_owner:npg_eWp3b1oJKNSX@ep-floral-field-aop1237c-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Admin demo password gate (presentation only — NOT production authentication).
ADMIN_DEMO_PASSWORD=12345

# Secret used to sign the admin session cookie. Change this in production.
ADMIN_SESSION_SECRET=change-me-in-production

# Public base URL used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Future Supabase integration (leave empty for the demo).
# Use the anon key in the browser only — never expose the service-role key.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
